# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.bbvf.org
# prelaunch keeps robots.txt closed; switch to live only after content approval.
NEXT_PUBLIC_SITE_STATUS=prelaunch
# Hostname of the preview proxy, used only in development.
PREVIEW_HOSTNAME=

# ---------------------------------------------------------------------------
# Supabase (server only — never expose the service-role key to the browser)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable/anon key: used for staff sign-in and token verification.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Card giving — Stripe hosted Checkout (no card data reaches BBVF)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CARD_CURRENCY=USD

# ---------------------------------------------------------------------------
# M-Pesa giving — Safaricom Daraja STK Push
# MPESA_ENV is "sandbox" or "production". The callback URL must be public HTTPS.
# ---------------------------------------------------------------------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://www.bbvf.org/api/webhooks/mpesa
